    "/api/insights/sales": {
      "get": {
        "operationId": "getSalesSummary",
        "summary": "Get completed-order regional sales",
        "description": "Half-open UTC interval [from,to) on completedAt. Distinct customers by historical order region. No partial totals on revision conflict or feed cap.",
        "tags": [
          "insights"
        ],
        "security": [
          {
            "clientCertificate": [],
            "accessToken": []
          }
        ],
        "x-visibility": "public",
