{
  "openapi": "3.1.0",
  "info": {
    "title": "Magic Shop insights API",
    "version": "0.1.0",
    "description": "Python-owned regions, completed-order reporting and local follow-up notes. Reports use a bounded Node service feed."
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [
    {
      "url": "https://shop.magic.test:8443",
      "description": "Public HAProxy gateway; human certificate required."
    }
  ],
