    {
      "clientCertificate": [],
      "accessToken": []
    }
  ],
  "paths": {
    "/api/insights/regions": {
      "get": {
        "operationId": "listRegions",
        "summary": "List local regions",
        "description": "FeatureCollection contains at most limit features, in stable regionId order; next-page cursor is conveyed in X-Next-Cursor header.",
        "tags": [
          "insights"
        ],
        "security": [
          {
            "clientCertificate": [],
            "accessToken": []
          }
        ],
        "x-visibility": "public",
        "x-auth": {
          "audience": "insights-api",
          "roles": [
            "shop-admin"
          ],
          "scope": null,
          "certificateCaller": "human",
          "tokenClient": "human",
          "pairing": "verified gateway certificate identity must equal signed cert_identity"
        },
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Page size; maximum 100.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque cursor from the previous page.",
            "schema": {
              "$ref": "#/components/schemas/Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegionCollection"
                }
              }
            },
            "headers": {
              "X-Next-Cursor": {
                "description": "Opaque cursor; omitted on final page.",
                "schema": {
                  "$ref": "#/components/schemas/Cursor"
                }
              }
            }
          },
          "400": {
            "description": "Invalid path, query, header or JSON request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "x-error-code": "invalid_request"
          },
          "401": {
            "description": "Missing, expired or invalid access token; TLS handshake failures have no HTTP response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "x-error-code": "invalid_token"
          },
          "403": {
