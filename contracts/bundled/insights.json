  "components": {
    "securitySchemes": {
      "clientCertificate": {
        "type": "mutualTLS",
        "description": "Caller certificate verified at the gateway (public) or service listener (private)."
      },
      "accessToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Keycloak access token, exact issuer https://auth.magic.test:9443/realms/magic-shop; ID tokens rejected."
      }
    },
    "schemas": {
      "RegionFeature": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "properties",
          "geometry"
        ],
        "properties": {
          "type": {
            "const": "Feature"
          },
          "properties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "regionId",
              "name",
              "center"
            ],
            "properties": {
              "regionId": {
                "$ref": "#/components/schemas/RegionId"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "center": {
                "$ref": "#/components/schemas/LonLat"
              }
            }
          },
          "geometry": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "coordinates"
            ],
            "properties": {
              "type": {
                "const": "Polygon"
              },
              "coordinates": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LonLat"
                  },
                  "minItems": 4,
                  "maxItems": 100
                },
                "minItems": 1,
                "maxItems": 10
              }
            }
          }
        }
      },
      "RegionCollection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "features"
        ],
        "properties": {
          "type": {
            "const": "FeatureCollection"
          },
          "features": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RegionFeature"
            },
            "maxItems": 100
          }
        }
      },
      "RegionalSales": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "regionId",
          "orderCount",
          "customerCount",
          "salesCopper"
        ],
        "properties": {
