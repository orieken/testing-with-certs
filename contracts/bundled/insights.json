          "audience": "insights-api",
          "roles": [
            "shop-admin"
          ],
          "scope": null,
          "certificateCaller": "human",
          "tokenClient": "human",
          "pairing": "verified gateway certificate identity must equal signed cert_identity"
        },
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "description": "Inclusive UTC completedAt boundary.",
            "schema": {
              "$ref": "#/components/schemas/UtcTimestamp"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "description": "Exclusive UTC completedAt boundary.",
            "schema": {
              "$ref": "#/components/schemas/UtcTimestamp"
