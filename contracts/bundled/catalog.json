{
  "openapi": "3.1.0",
  "info": {
    "title": "Magic Shop catalog API",
    "version": "0.1.0",
    "description": "Go-owned item catalog. All public operations require human mTLS plus a matching user access token. Private quotes require the paired Node service identity."
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [
    {
      "url": "https://shop.magic.test:8443",
      "description": "Public HAProxy gateway; human certificate required."
    }
  ],
  "security": [
    {
      "clientCertificate": [],
      "accessToken": []
    }
  ],
  "paths": {
    "/api/catalog/items": {
      "get": {
        "operationId": "listItems",
        "summary": "List active items",
        "description": "Returns only active items in stable id order; archived items do not appear.",
        "tags": [
          "catalog"
        ],
        "security": [
          {
            "clientCertificate": [],
            "accessToken": []
          }
        ],
        "x-visibility": "public",
        "x-auth": {
          "audience": "catalog-api",
          "roles": [
            "customer",
            "shopkeeper",
            "shop-admin"
          ],
          "scope": null,
          "certificateCaller": "human",
          "tokenClient": "human",
          "pairing": "verified gateway certificate identity must equal signed cert_identity"
        },
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Page size; maximum 100.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque cursor from the previous page.",
            "schema": {
              "$ref": "#/components/schemas/Cursor"
            }
          },
          {
            "name": "categoryId",
            "in": "query",
            "required": false,
            "description": "Optional category.",
            "schema": {
              "$ref": "#/components/schemas/Id"
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Case-insensitive name search.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid path, query, header or JSON request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "x-error-code": "invalid_request"
          },
          "401": {
            "description": "Missing, expired or invalid access token; TLS handshake failures have no HTTP response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "x-error-code": "invalid_token"
          },
          "403": {
            "description": "Wrong role, scope, service identity or certificate/token identity pairing.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "x-error-code": "forbidden"
          }
        }
      },
      "post": {
        "operationId": "createItem",
        "summary": "Create item",
        "description": "Create item",
        "tags": [
          "catalog"
        ],
        "security": [
          {
            "clientCertificate": [],
            "accessToken": []
          }
        ],
        "x-visibility": "public",
        "x-auth": {
          "audience": "catalog-api",
          "roles": [
            "shopkeeper",
            "shop-admin"
          ],
          "scope": null,
          "certificateCaller": "human",
          "tokenClient": "human",
          "pairing": "verified gateway certificate identity must equal signed cert_identity"
        },
        "parameters": [],
        "responses": {
          "201": {
            "description": "Created resource.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            },
            "headers": {
              "Location": {
                "required": true,
                "description": "Canonical public resource path.",
                "schema": {
                  "type": "string",
                  "pattern": "^/api/"
                }
              }
            }
          },
          "400": {
            "description": "Invalid path, query, header or JSON request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "x-error-code": "invalid_request"
          },
          "401": {
            "description": "Missing, expired or invalid access token; TLS handshake failures have no HTTP response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "x-error-code": "invalid_token"
          },
          "403": {
            "description": "Wrong role, scope, service identity or certificate/token identity pairing.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "x-error-code": "forbidden"
          },
          "409": {
            "description": "Idempotency-key reuse or dataset revision conflict.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "x-error-code": "conflict"
          },
          "422": {
            "description": "Validly shaped request violates a business rule.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "x-error-code": "unprocessable"
          }
        },
        "requestBody": {
          "required": true,
          "description": "New item. ID is server assigned.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ItemCreate"
              }
            }
          }
        }
      }
    },
