      "delete": {
        "operationId": "archiveItem",
        "summary": "Archive item",
        "description": "Idempotent archive; historical order snapshots remain unchanged.",
        "tags": [
          "catalog"
        ],
        "security": [
          {
            "clientCertificate": [],
            "accessToken": []
          }
        ],
        "x-visibility": "public",
        "x-auth": {
          "audience": "catalog-api",
          "roles": [
            "shopkeeper",
            "shop-admin"
          ],
          "scope": null,
          "certificateCaller": "human",
          "tokenClient": "human",
          "pairing": "verified gateway certificate identity must equal signed cert_identity"
        },
        "parameters": [
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Archived; no response body."
          },
          "400": {
            "description": "Invalid path, query, header or JSON request.",
            "content": {
              "application/json": {
                "schema": {
