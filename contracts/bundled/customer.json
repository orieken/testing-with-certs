      "post": {
        "operationId": "createOrder",
        "summary": "Create simulated order",
        "description": "Node obtains current quotes using its private service identity, snapshots prices, and atomically persists order plus idempotency result. No payment or inventory reservation.",
        "tags": [
          "customer"
        ],
        "security": [
          {
            "clientCertificate": [],
            "accessToken": []
          }
        ],
        "x-visibility": "public",
