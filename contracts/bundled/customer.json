            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Profile"
            },
            "maxItems": 100
          },
          "nextCursor": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Cursor"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "ReportingRecord": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "customer"
        ],
        "properties": {
          "order": {
            "$ref": "#/components/schemas/Order"
          },
          "customer": {
            "$ref": "#/components/schemas/Profile"
          }
        }
      },
      "ReportingPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision",
          "items",
          "nextCursor"
        ],
        "properties": {
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReportingRecord"
            },
            "maxItems": 100
          },
          "nextCursor": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Cursor"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Subject": {
        "type": "string",
        "format": "uuid"
      },
      "RegionId": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
        "maxLength": 64
      },
      "LonLat": {
        "type": "array",
        "prefixItems": [
          {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          }
        ],
        "minItems": 2,
        "maxItems": 2,
        "items": false
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,63}$"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        }
      },
      "Cursor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "Id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
        "maxLength": 64
      },
      "UtcTimestamp": {
        "type": "string",
        "format": "date-time",
        "pattern": "Z$"
      },
      "Copper": {
        "type": "integer",
        "format": "int64",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "Quantity": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    }
  }
