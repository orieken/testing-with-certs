          "audience": "customer-api",
          "roles": [
            "customer",
            "shopkeeper",
            "shop-admin"
          ],
          "scope": null,
          "certificateCaller": "human",
          "tokenClient": "human",
          "pairing": "verified gateway certificate identity must equal signed cert_identity"
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Scoped to the verified owner sub; same key and body returns the original 201 order and Location.",
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created resource.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            },
            "headers": {
              "Location": {
                "required": true,
                "description": "Canonical public resource path.",
                "schema": {
                  "type": "string",
                  "pattern": "^/api/"
                }
              }
            }
          },
