            "$ref": "#/components/schemas/Id"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "unitPriceCopper": {
            "$ref": "#/components/schemas/Copper"
          },
          "quantity": {
            "$ref": "#/components/schemas/Quantity"
          },
          "lineTotalCopper": {
            "$ref": "#/components/schemas/Copper"
          }
        }
      },
      "Order": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "orderId",
          "ownerSub",
          "regionId",
          "status",
          "createdAt",
          "completedAt",
          "lines",
          "totalCopper"
        ],
        "properties": {
          "orderId": {
            "$ref": "#/components/schemas/Id"
          },
          "ownerSub": {
            "$ref": "#/components/schemas/Subject"
          },
