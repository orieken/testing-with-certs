          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Page size; maximum 100.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque cursor from the previous page.",
            "schema": {
              "$ref": "#/components/schemas/Cursor"
            }
          },
          {
            "name": "revision",
            "in": "query",
            "required": false,
            "description": "Required after first page; must match the original dataset revision.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          {
            "name": "regionId",
            "in": "query",
            "required": false,
            "description": "Historical order region filter.",
            "schema": {
              "$ref": "#/components/schemas/RegionId"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "Inclusive UTC completedAt boundary.",
            "schema": {
              "$ref": "#/components/schemas/UtcTimestamp"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "Exclusive UTC completedAt boundary.",
            "schema": {
              "$ref": "#/components/schemas/UtcTimestamp"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportingPage"
                }
              }
            }
          },
          "400": {
