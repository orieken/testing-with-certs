          }
        },
        "servers": [
          {
            "url": "https://customer-api:8443",
            "description": "Private service listener; never routed through public HAProxy."
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "clientCertificate": {
        "type": "mutualTLS",
        "description": "Caller certificate verified at the gateway (public) or service listener (private)."
      },
      "accessToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Keycloak access token, exact issuer https://auth.magic.test:9443/realms/magic-shop; ID tokens rejected."
      }
    },
    "schemas": {
      "Profile": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sub",
          "displayName",
          "regionId",
          "location"
        ],
        "properties": {
          "sub": {
            "$ref": "#/components/schemas/Subject"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "regionId": {
            "$ref": "#/components/schemas/RegionId"
          },
          "location": {
            "$ref": "#/components/schemas/LonLat"
          }
        }
      },
      "ProfilePatch": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "regionId": {
            "$ref": "#/components/schemas/RegionId"
          },
          "location": {
            "$ref": "#/components/schemas/LonLat"
          }
        },
        "minProperties": 1
      },
      "CheckoutLine": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "itemId",
          "quantity"
        ],
        "properties": {
