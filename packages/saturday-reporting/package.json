{
  "name": "@orieken/saturday-reporting",
  "version": "0.1.0",
  "description": "Portable Saturday HTML test reports and report merging",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node build-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/orieken/testing-with-certs.git",
    "directory": "packages/saturday-reporting"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "5.9.3"
  },
  "bin": {
    "saturday-report": "./dist/cli.js"
  }
}
