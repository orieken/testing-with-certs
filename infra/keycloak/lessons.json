  "clients": [
    {
      "clientId": "passkeys-spa",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": [
        "basic",
        "profile"
      ],
      "optionalClientScopes": [],
      "redirectUris": [
        "https://shop.magic.test:8543/teaching/passkeys/callback"
      ],
      "webOrigins": [
        "https://shop.magic.test:8543"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://shop.magic.test:8543/teaching/passkeys"
      },
      "authenticationFlowBindingOverrides": {
        "browser": "passkeys-browser"
      },
      "protocolMappers": [
        {
          "name": "lesson-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "passkeys-lesson",
            "access.token.claim": "true",
            "id.token.claim": "false"
