{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["site/**/*.ts", "api/**/*.ts", "playwright/**/*.ts", "playwright.config.ts", "playwright.browser.config.ts", "playwright.package.config.ts", "playwright.teaching.config.ts"]
}
