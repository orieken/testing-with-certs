{
  "name": "@magic-shop/testing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Shared Saturday site models, Cucumber and Playwright suites, and API contracts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "contracts:validator": "playwright test --project=contracts-validator",
    "contracts:live": "playwright test --project=contracts",
    "browser:record": "playwright test --config playwright.browser.config.ts",
    "contracts:coverage": "node ../infra/check-contract-coverage.mjs"
  },
  "dependencies": {
    "@cucumber/cucumber": "12.9.0",
    "@orieken/saturday-core": "0.1.3",
    "@orieken/saturday-cucumber": "0.1.1",
    "@playwright/test": "1.61.0",
    "@xmldom/xmldom": "0.9.12",
    "saturday-keycloak-prototype": "workspace:*",
    "xml-crypto": "6.4.0"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "5.9.3"
  }
}
